# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudflare R2 Storage (S3-compatible bucket for assignment files & QR images)
# Set either R2_ACCOUNT_ID or full R2_ENDPOINT (e.g. https://<account_id>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Telegram Bot Alerts (Optional server-side notifications for Deadlines, Revisions & Client Chat)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

