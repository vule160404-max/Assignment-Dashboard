{
  "manifest_version": 3,
  "name": "AssignTrack HIX Bypass Bridge",
  "version": "1.2.0",
  "description": "Kết nối an toàn & hỗ trợ chạy song song nhiều tab hixbypass.com cùng lúc từ trình chiếu Word trên AssignTrack.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://hixbypass.com/*",
    "https://*.hixbypass.com/*",
    "https://bypass.hix.ai/*",
    "https://*.hix.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AssignTrack HIX Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://*.run.app/*",
        "https://*.vercel.app/*",
        "https://*.pages.dev/*",
        "https://*.web.app/*",
        "https://*.firebaseapp.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hixbypass.com/*",
        "https://*.hixbypass.com/*",
        "https://bypass.hix.ai/*",
        "https://*.hix.ai/*"
      ],
      "js": ["hix_content.js"],
      "run_at": "document_idle"
    }
  ]
}
